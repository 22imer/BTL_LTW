#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Main website where customers see drinks, menu and prices (https:// is added if missing)
WEBSITE_URL=

# Optional; defaults shown
STORES_FILE=
DB_PATH=


